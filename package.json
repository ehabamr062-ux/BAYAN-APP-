{
  "name": "bayan-pos-desktop",
  "version": "6.0.2",
  "description": "تطبيق بيان POS Pro المحاسبي الذكي - نسخة سطح المكتب الخاطفة والعمل أوفلاين",
  "main": "main-electron.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "pos",
    "accounting",
    "bayan"
  ],
  "author": "Bayan POS Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.bayanpos.app",
    "productName": "Bayan POS Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "برنامج بيان POS Pro للمحاسبة اليومية",
      "uninstallDisplayName": "حذف برنامج بيان POS Pro"
    }
  }
}
